# Copy this file to ".env" (same folder) and fill in the values.
# .env is secret: it is in .gitignore and is never sent to the browser.

# Spotify Developer Dashboard → your app → Settings
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Printed by "npm run get-token" (run it once)
SPOTIFY_REFRESH_TOKEN=

# GitHub activity heatmap (server only — never put it in a front-end file).
# github.com → Settings → Developer settings → Personal access tokens →
# Fine-grained token → "Public repositories" (read-only), no extra permissions.
GITHUB_TOKEN=

# Claude Code token usage (Activity section). The collector runs on YOUR computer
# (npm run usage:watch) and publishes only daily token totals to a private Gist.
# Token: github.com → Settings → Developer settings → Fine-grained token →
# Account permissions → Gists: Read and write. Keep it local (the site never needs it).
CLAUDE_USAGE_GIST_TOKEN=
# Printed by "npm run usage:sync -- --create-gist". Also add it to Vercel's
# Environment Variables (the site reads the Gist with it).
CLAUDE_USAGE_GIST_ID= 